# Patch 0909 (device report of DevJunior, 11.11.2026: reloading the long guns without aiming, Leon still stopped
# for a moment as if to aim). The mods' reload without aiming (runtime/free_move.cpp: the prototype's direct
# reload, PlReloadDirect 1) ends at PlReloadEndTbl's frame when the aim key is not held. Past the reload motion's
# end the shotgun (Seq_frame_num - 1) and the machine gun (MotionMove done) go to the aiming state, the rifle
# (5 frames before the end) puts the scope back on, whichever comes first; in the prototype's own direct reload
# (reload key type 1) the same. Without aiming they now leave there as at the end frame (footwork, the down
# state, crouching); with the aim key held, or the reload started from aiming (PlReloadDirect 0), unchanged.
--- a/src/wep/pl_shotgun.cpp
+++ b/src/wep/pl_shotgun.cpp
@@ -553,7 +553,27 @@
                 }
             }
             if (pl->Motion.Seq_frame >= (f32) (pl->Motion.Seq_frame_num - 1)) {
-                pl->setRno(0, 6, 1, 0);
+                if (PlReloadDirect == 1 && joyKamae() == 0) {
+                    /* port (patch 0909): a reload without aiming ends as above at the motion's end, not in the
+                       aiming state */
+                    if (pl->r_no_1 == 6) {
+                        if (pl->stat.check(cPlayer::F_CROUCH)) {
+                            pl->r_no_0 = 0;
+                            pl->r_no_2 = 0;
+                            pl->r_no_1 = 0x11;
+                            pl->r_no_3 = 0;
+                        } else {
+                            pl->m_Hokan = 9;
+                            pl->m_Frame = 0;
+                            pl->r_no_0 = 0;
+                            pl->r_no_1 = 0;
+                            pl->r_no_2 = 0;
+                            pl->r_no_3 = 2;
+                        }
+                    }
+                } else {
+                    pl->setRno(0, 6, 1, 0);
+                }
             }
         }
         break;
