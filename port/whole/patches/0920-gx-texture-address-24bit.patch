@@ -1106,7 +1106,7 @@
             tmem2 = (i & 1) ? tmemGB : tmemAR;
             __GetImageTileCount(t->fmt, (u16) (wd >> (i + 1)), (u16) (ht >> (i + 1)), &rowTiles, &colTiles, &cmpTiles);
             nTiles = rowTiles * colTiles;
-            SET_REG_FIELD(1957, loadImage0, 21, 0, base);
